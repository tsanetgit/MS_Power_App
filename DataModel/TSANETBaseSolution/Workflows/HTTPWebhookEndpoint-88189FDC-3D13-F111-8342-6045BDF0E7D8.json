{
  "properties": {
    "connectionReferences": {},
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "b8f7d2de-7796-49d1-9c55-b2f812d28e4c"
          },
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "method": "POST",
            "triggerAuthenticationType": "User",
            "triggerAllowedUsers": "fb4b4d2a-113f-4f5c-9b4b-43f3690b7eaa"
          }
        }
      },
      "actions": {
        "Secret": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "7f26725a-e337-4c87-83ed-ef07e596e03b"
          },
          "type": "Compose",
          "inputs": "@trim(triggerOutputs()['headers']['x-hub-signature-256'])"
        },
        "Token": {
          "runAfter": {
            "Secret": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "9b19f129-b363-4437-93a6-d0cb250576c8"
          },
          "type": "Compose",
          "inputs": "@if(equals(triggerBody()?['requestToken'],null),triggerBody()?['data/requestToken'],triggerBody()?['requestToken'])"
        },
        "StartProcessor": {
          "runAfter": {
            "Token": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "2728bf99-780a-4fb2-a79e-bd9563171fc9"
          },
          "type": "Workflow",
          "inputs": {
            "host": {
              "workflowReferenceName": "9e18f123-bec0-f111-a05a-0022482c8676"
            },
            "body": {
              "text": "@string(triggerBody())",
              "text_1": "@outputs('Secret')",
              "text_2": "@outputs('Token')"
            }
          }
        },
        "IsSuccess": {
          "actions": {
            "Response_Success": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "22af0add-79d5-42b1-92dd-697075bc9db1"
              },
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 200
              }
            }
          },
          "runAfter": {
            "StartProcessor": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Response_Error": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "ee38433c-f179-4f0b-81d8-cb6bd216c558"
                },
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 500,
                  "body": {
                    "Message": "@{body('StartProcessor')?['message']}"
                  }
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@body('StartProcessor')?['result']",
              "Success"
            ]
          },
          "metadata": {
            "operationMetadataId": "29f217c8-6ded-4243-a3ae-edc75ce3d6b1"
          },
          "type": "If"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}